NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agripool

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Filled in after `stellar contract deploy` — see docs/DEPLOYMENT.md
CONTRACT_ID=
# A funded testnet account used only to simulate read calls (no signing key needed here)
SOROBAN_READ_SOURCE_ACCOUNT=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
