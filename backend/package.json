{
  "name": "agripool-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgriPool API — off-chain services (auth, listings, feedback, analytics) that complement the on-chain settlement contract.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
